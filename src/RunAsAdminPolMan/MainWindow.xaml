<Window x:Class="RunAsAdminPolMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:RunAsAdminPolMan.ViewModels"
        xmlns:views="clr-namespace:RunAsAdminPolMan.Views"
        mc:Ignorable="d"
        Title="RunAsAdmin Policy Manager" Height="600" Width="900"
        Background="#282828" Foreground="#ebdbb2"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <!-- Styles are now globally managed via App.xaml and GruvboxTheme.xaml -->

        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
            <views:PolicyDataGridView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="#282828">
            <TextBlock Text="RunAsAdmin Policy Manager" Foreground="#ebdbb2" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="🗕" Click="Minimize_Click" Width="40" Background="Transparent" FontFamily="Segoe UI Symbol" BorderThickness="0"/>
                <Button Content="🗖" Click="Maximize_Click" Width="40" Background="Transparent" FontFamily="Segoe UI Symbol" BorderThickness="0"/>
                <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" FontFamily="Segoe UI Symbol" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1">
            <!-- Menu Bar -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="Add Policy..." Command="{Binding OpenFileDialogAndAddPoliciesCommand}"/>
                    <MenuItem Header="Remove Policy" Command="{Binding RemovePolicyCommand}"/>
                    <Separator/>
                    <MenuItem Header="Settings" Command="{Binding ToggleSettingsViewCommand}"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Command="{Binding CloseWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Refresh" Command="{Binding LoadPoliciesCommand}"/>
                    <MenuItem Header="Toggle Scope (HKCU / HKLM)" Command="{Binding ToggleScopeCommand}"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="About"/>
                </MenuItem>
            </Menu>

            <!-- ToolBar -->
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button Content="Add Policy" Command="{Binding OpenFileDialogAndAddPoliciesCommand}"/>
                    <Button Content="Refresh" Command="{Binding LoadPoliciesCommand}"/>
                    <Button Content="Remove Selected" Command="{Binding RemovePolicyCommand}"/>
                    <Separator/>
                    <Button Content="Toggle Scope" Command="{Binding ToggleScopeCommand}"/>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#b8bb26" Text="{Binding CurrentScope, StringFormat='Current Scope: {0}'}"/>
                    <Separator/>
                    <Button Content="Settings" Command="{Binding ToggleSettingsViewCommand}"/>
                </ToolBar>
            </ToolBarTray>

            <!-- Status Bar -->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentScope, StringFormat='Active Scope: {0}'}" FontWeight="Bold" Foreground="#fabd2f" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding Policies.Count, StringFormat='Items: {0}'}"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!-- Main Content Region -->
            <ContentControl Content="{Binding CurrentViewModel}" />
        </DockPanel>
    </Grid>
</Window>
