<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gruvbox Colors -->
    <Color x:Key="GruvboxBg">#282828</Color>
    <Color x:Key="GruvboxBg1">#3c3836</Color>
    <Color x:Key="GruvboxBg2">#504945</Color>
    <Color x:Key="GruvboxFg">#ebdbb2</Color>
    <Color x:Key="GruvboxRed">#cc241d</Color>
    <Color x:Key="GruvboxGreen">#98971a</Color>
    <Color x:Key="GruvboxYellow">#d79921</Color>
    <Color x:Key="GruvboxBlue">#458588</Color>
    
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource GruvboxBg}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource GruvboxBg1}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource GruvboxBg2}"/>
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource GruvboxFg}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource GruvboxBlue}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource GruvboxYellow}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource GruvboxRed}"/>
    
    <!-- General UI Styles -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="Padding" Value="2"/>
    </Style>
    
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
    </Style>



    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <!-- DataGrid Styling -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource BgBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bg2Brush}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
